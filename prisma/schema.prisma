  generator client {
  provider = "prisma-client-js"
  // output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model BulkEmail {
  id String @id @default(cuid())
  title String?
  subject   String
  body      String
  senderName String?
  senderEmail String?
  previewText String?
  scheduledAt DateTime?
  isDraft Boolean @default(false)
  status    EmailStatus @default(PENDING)
  createdAt DateTime    @default(now())
  sentAt    DateTime?
  EmailLog  EmailLog[]

  emailQueues EmailQueue[]
  mediaAttachments CampaignMedia[]
}

model EmailLog {
  id String @id @default(cuid())
  bulkEmailId    String
  recipientId    String
  status         EmailStatus
  messageId      String?
  error          String?
  createdAt      DateTime       @default(now())
  BulkEmail      BulkEmail      @relation(fields: [bulkEmailId], references: [id])
  EmailRecipient EmailRecipient @relation(fields: [recipientId], references: [id])
}

model EmailRecipient {
 id String @id @default(cuid())
  email     String     @unique
  name      String?
  createdAt DateTime   @default(now())
  EmailLog  EmailLog[]

  emailQueues EmailQueue[]
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mediaAssets MediaAsset[]
}

model MediaAsset {
  id          String      @id @default(cuid())
  title       String?
  altText     String?
  description String?
  type        MediaType
  bucket      String
  path        String      @unique
  publicUrl   String?
  mimeType    String
  sizeBytes   Int
  width       Int?
  height      Int?
  durationSec Int?
  section     MediaSection @default(GALLERY)
  isPublished Boolean     @default(false)
  sortOrder   Int         @default(0)
  uploadedById String?
  uploadedBy   User?      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  campaignAttachments CampaignMedia[]

  @@index([section, isPublished, sortOrder])
  @@index([type, createdAt])
  @@index([uploadedById])
}

model CampaignMedia {
  id          String     @id @default(cuid())
  campaignId  String
  mediaAssetId String
  placement    MediaPlacement @default(BODY)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  campaign   BulkEmail  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([campaignId, mediaAssetId, placement])
  @@index([campaignId, placement, sortOrder])
  @@index([mediaAssetId])
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaSection {
  GALLERY
  CAREER
  WELLNESS
  WORKSHOPS
  TESTIMONIALS
  CAMPAIGNS
}

enum MediaPlacement {
  HERO
  BODY
  FOOTER
  ATTACHMENT
}

enum EmailStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model EmailQueue {
  id            String   @id
  campaignId    String
  recipientId   String
  email         String
  subject       String
  body          String
  status        QueueStatus @default(PENDING)
  attempts      Int      @default(0)
  error         String?
  createdAt     DateTime @default(now())
  processedAt   DateTime?

  BulkEmail     BulkEmail      @relation(fields: [campaignId], references: [id])
  EmailRecipient EmailRecipient @relation(fields: [recipientId], references: [id])
}

model RefundPolicy {
  id          String              @id @default(cuid())
  order       Int
  description String
  status      RefundPolicyStatus @default(ACTIVE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

enum QueueStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum RefundPolicyStatus {
  ACTIVE
  ARCHIVED
}

model RefundPolicySection {
  id         String                     @id @default(cuid())
  title      String?
  order      Int
  status     RefundPolicyStatus        @default(ACTIVE)
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt

  paragraphs RefundPolicyParagraph[]
}

model RefundPolicyParagraph {
  id        String                  @id @default(cuid())
  sectionId String
  order     Int
  text      String
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  section   RefundPolicySection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, order])
}

model FreeConsultationLead {
  id        String   @id @default(cuid())
  phone     String
  email     String
  status    ConsultationStatus @default(NEW)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

enum ConsultationStatus {
  NEW
  CONTACTED
  BOOKED
  CLOSED
}
